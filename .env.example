# قواعد التخزين والمنافذ — انسخ هذا الملف إلى .env أو صدّر المتغيّرات قبل التشغيل
# Storage and port settings — copy to .env or export these before starting.
# Every value below is optional; the defaults are what the tool ships with.

# ── الشبكة / Network ──────────────────────────────────────────────
# 127.0.0.1 يعني أن الأداة لا تُرى إلا من جهازك. لا تغيّرها إلى 0.0.0.0 إلا إذا
# كنت تفهم أنك تفتحها لكل من على الشبكة، فلا توجد فيها مصادقة.
# 127.0.0.1 means only your own machine can reach it. Do not change this to
# 0.0.0.0 unless you understand you are exposing it to your whole network —
# there is no authentication.
HOST=127.0.0.1
PORT=4173

# ── مسار FFmpeg / FFmpeg location ─────────────────────────────────
# اتركها فارغة إذا كان ffmpeg في PATH. على ويندوز مثلاً:
# Leave as-is if ffmpeg is on your PATH. On Windows, for example:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── التخزين / Storage ─────────────────────────────────────────────
# مكان حفظ الملفات المرفوعة والناتجة. ضعها على قرص فيه مساحة كافية —
# ملفات 4K تصل إلى مئات الميغابايت للمقطع الواحد.
# Where uploads and results live. Put this on a disk with room to spare —
# a single 4K master can run to hundreds of megabytes.
STORAGE_DIR=./storage

# حجم أقصى للملف الواحد (بالبايت). الافتراضي 12 غيغابايت.
# Maximum size for a single upload, in bytes. Default is 12 GB.
MAX_UPLOAD_BYTES=12884901888

# حجم القطعة الواحدة في الرفع (بالبايت). 8 ميغابايت مناسبة لمعظم الحالات.
# Upload chunk size in bytes. 8 MB suits almost everyone.
UPLOAD_CHUNK_BYTES=8388608

# تُحذف المهام المنتهية وملفاتها بعد هذه المدّة بالساعات. 0 يوقف الحذف تماماً.
# Finished jobs and their files are deleted after this many hours. 0 disables cleanup.
RETENTION_HOURS=48

# ── الأداء / Performance ──────────────────────────────────────────
# عدد المهام المتوازية. اتركها 1: x264 يستخدم كل الأنوية أصلاً، وتشغيل مهمتين
# معاً يجعل كلتيهما أبطأ.
# How many encodes run at once. Leave this at 1: x264 already uses every core,
# and running two jobs together just makes both slower.
CONCURRENCY=1

# عدد خيوط الترميز. 0 يعني اترك القرار لـ x264 (وهو الأفضل عادةً).
# Encoder threads. 0 lets x264 decide, which is usually right.
ENCODE_THREADS=0
